FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    AI_SERVICE_HOST=0.0.0.0 \
    AI_SERVICE_PORT=8015

WORKDIR /app
COPY python-ai-service/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY python-ai-service/app ./app

EXPOSE 8015
CMD ["sh", "-c", "access_log_flag=--no-access-log; if [ \"${AI_ACCESS_LOG:-false}\" = \"true\" ]; then access_log_flag=; fi; exec uvicorn app.main:app --host ${AI_SERVICE_HOST:-0.0.0.0} --port ${AI_SERVICE_PORT:-8015} ${access_log_flag}"]

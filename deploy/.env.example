TZ=Asia/Shanghai

# =========================
# Bounded runtime logs
# =========================
# Host logs rotate by local calendar day; HOST_LOG_MAX_FILES is the archive limit per stream per day.
HOST_LOG_MAX_SIZE_MB=10
HOST_LOG_MAX_FILES=3
HOST_LOG_RETENTION_DAYS=30
# Refuse a full startup when the project filesystem has less free space than this.
MIN_FREE_DISK_MB=2048
# Docker json-file logs are bounded per container.
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILES=30
# Set true only while diagnosing HTTP traffic; health checks otherwise create noisy access logs.
AI_ACCESS_LOG=false

# =========================
# MySQL
# =========================
MYSQL_VERSION=8.4
MYSQL_PORT=13306
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=smart_worksite
MYSQL_USER=worksite
MYSQL_PASSWORD=worksite

# Java连接MySQL
DB_HOST=localhost
DB_USERNAME=worksite
DB_PASSWORD=worksite

# =========================
# Redis
# =========================
REDIS_VERSION=7.2-alpine
REDIS_PORT=16379
REDIS_HOST=localhost

# =========================
# MinIO
# =========================
MINIO_VERSION=RELEASE.2025-04-22T22-12-26Z
MINIO_MC_VERSION=RELEASE.2025-04-16T18-13-26Z

MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

MINIO_BUCKET=smart-worksite
MINIO_ENDPOINT=http://localhost:${MINIO_API_PORT}

FILE_ACCESS_URL_EXPIRE_SECONDS=600
FILE_MAX_SIZE_BYTES=104857600
FILE_MULTIPART_MAX_FILE_SIZE=100MB
FILE_MULTIPART_MAX_REQUEST_SIZE=100MB
FILE_PARSE_ENABLED=true
FILE_PARSE_MAX_PAGES=100
FILE_PARSE_RESULT_PREVIEW_LENGTH=2000
FILE_PARSE_MAX_INPUT_CHARS=120000
QWEN_VL_ENDPOINT=http://127.0.0.1:18000/v1/chat/completions
# Endpoint used by the Python AI container on the Compose network.
QWEN_VL_CONTAINER_ENDPOINT=http://local-llm:8000/v1/chat/completions
QWEN_VL_API_KEY=
QWEN_VL_MODEL=smart-worksite-chat
QWEN_VL_CONNECT_TIMEOUT_MS=5000
QWEN_VL_READ_TIMEOUT_MS=120000
# Java MinIO Client
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# =========================
# CryptoAgentV3
# =========================
CRYPTO_AGENT_V3_BASE_URL=http://127.0.0.1:8012
CRYPTO_AGENT_V3_INVOKE_PATH=/v1/report-generation/invoke
CRYPTO_AGENT_V3_CONNECT_TIMEOUT_SECONDS=5
CRYPTO_AGENT_V3_READ_TIMEOUT_SECONDS=3000000

# =========================
# Java
# =========================
SERVER_PORT=8080
AI_PYTHON_BASE_URL=http://127.0.0.1:8015
AI_PYTHON_API_KEY=dev-ai-service-key
AI_PYTHON_AUTO_START_ENABLED=true
AI_PYTHON_AUTO_START_WORKDIR=python-ai-service
AI_PYTHON_AUTO_START_PYTHON=
AI_PYTHON_AUTO_START_TIMEOUT_SECONDS=45
AI_SERVICE_PORT=8015
AI_DATABASE_MAX_ROWS=100
AI_DATABASE_QUERY_TIMEOUT_SECONDS=15
# SQL generation repair attempts for database Q&A/report variables.
# Authentication and connection failures are not retried.
AI_DATABASE_QUERY_MAX_ATTEMPTS=4
AI_DEPLOYMENT_MODE=LOCAL_ONLY
QWEN_BASE_URL=http://local-llm:8000/v1
QWEN_API_KEY=
QWEN_MODEL=smart-worksite-chat
QWEN_EMBEDDING_BASE_URL=http://local-embedding:8000/v1
QWEN_EMBEDDING_MODEL=smart-worksite-embedding
QWEN_EMBEDDING_DIMENSIONS=0
QWEN_RERANK_BASE_URL=http://local-reranker:8081/v1/rerank
QWEN_RERANK_MODEL=smart-worksite-reranker
QWEN_RERANK_API_STYLE=QWEN3

AI_DATA_SOURCE_PASSWORD_KEY=

# =========================
# Optional vector stores
# =========================
PGVECTOR_VERSION=pg16
PGVECTOR_PORT=15432
PGVECTOR_DATABASE=smart_worksite_vector
PGVECTOR_USER=worksite
PGVECTOR_PASSWORD=worksite

MILVUS_VERSION=v2.5.4
MILVUS_PORT=19530
MILVUS_METRICS_PORT=19091
MILVUS_ETCD_VERSION=v3.5.18
MILVUS_MINIO_PORT=19002
MILVUS_MINIO_ACCESS_KEY=minioadmin
MILVUS_MINIO_SECRET_KEY=minioadmin
# 异步任务：报告生成、知识库入库等
TASK_OUTBOX_DISPATCHER_ENABLED=true
TASK_WORKER_ENABLED=true

# Local-only H100 PCIe 80GB profile. Copy to deploy/.env or pass with --model-profile.
MODEL_PROFILE_NAME=h100-fp8
AI_DEPLOYMENT_MODE=LOCAL_ONLY

# Pin the serving runtime separately so upgrades are deliberate.
VLLM_IMAGE=vllm/vllm-openai:v0.27.1-cu129@sha256:07913e94a58a4e61322c88f8d4647411b4dd394838b53abacaa32448d9d8de0a
NVIDIA_RUNTIME_TEST_IMAGE=nvidia/cuda:12.2.2-base-ubuntu22.04@sha256:1a8a738e81d4adbef0c709241f5238cec5bb77186dcb5b2103db293315ed42d1
MIN_NVIDIA_DRIVER_MAJOR=535
MODEL_HEALTH_TIMEOUT_SECONDS=30
MODEL_STARTUP_TIMEOUT_SECONDS=3600
MODEL_CACHE_VOLUME=smart-worksite-model-cache
HF_ENDPOINT=https://hf-mirror.com

# Main multimodal chat model. Qwen3.8-27B-FP8 is the H100 target.
CHAT_MODEL_ID=Qwen/Qwen3.8-27B-FP8
CHAT_MODEL_REVISION=017b9c7af6b5689d5dd426a76e0bc077eb5ca20a
CHAT_MODEL_NAME=smart-worksite-chat
CHAT_TENSOR_PARALLEL_SIZE=1
CHAT_GPU_COUNT=1
CHAT_CUDA_VISIBLE_DEVICES=0
CHAT_MAX_MODEL_LEN=16384
CHAT_MAX_NUM_SEQS=2
CHAT_GPU_MEMORY_UTILIZATION=0.65
CHAT_HOST_PORT=18000

# Auxiliary local embedding model.
EMBEDDING_MODEL_ID=Qwen/Qwen3-Embedding-4B
EMBEDDING_MODEL_REVISION=5cf2132abc99cad020ac570b19d031efec650f2b
EMBEDDING_MODEL_NAME=smart-worksite-embedding
EMBEDDING_GPU_COUNT=1
EMBEDDING_CUDA_VISIBLE_DEVICES=0
EMBEDDING_MAX_MODEL_LEN=8192
EMBEDDING_MAX_NUM_SEQS=4
EMBEDDING_GPU_MEMORY_UTILIZATION=0.15
EMBEDDING_HOST_PORT=18001

# Local Qwen3 reranker. vLLM exposes the Cohere-compatible /rerank endpoint.
RERANK_MODEL_ID=Qwen/Qwen3-Reranker-0.6B
RERANK_MODEL_REVISION=e61197ed45024b0ed8a2d74b80b4d909f1255473
RERANK_MODEL_NAME=smart-worksite-reranker
RERANK_GPU_COUNT=1
RERANK_CUDA_VISIBLE_DEVICES=0
RERANK_MAX_MODEL_LEN=4096
RERANK_MAX_NUM_SEQS=8
RERANK_GPU_MEMORY_UTILIZATION=0.08
RERANK_HOST_PORT=18002
RERANK_HF_OVERRIDES={"architectures":["Qwen3ForSequenceClassification"],"classifier_from_token":["no","yes"],"is_original_qwen3_reranker":true}

# Service URLs used by the Python AI container; these are never public endpoints.
QWEN_BASE_URL=http://local-llm:8000/v1
QWEN_MODEL=smart-worksite-chat
QWEN_VL_ENDPOINT=http://127.0.0.1:18000/v1/chat/completions
QWEN_VL_CONTAINER_ENDPOINT=http://local-llm:8000/v1/chat/completions
QWEN_VL_MODEL=smart-worksite-chat
QWEN_EMBEDDING_BASE_URL=http://local-embedding:8000/v1
QWEN_EMBEDDING_MODEL=smart-worksite-embedding
QWEN_EMBEDDING_DIMENSIONS=0
QWEN_RERANK_BASE_URL=http://local-reranker:8000/v1/rerank
QWEN_RERANK_MODEL=smart-worksite-reranker
QWEN_RERANK_API_STYLE=QWEN3
RAG_PROVIDER=LOCAL

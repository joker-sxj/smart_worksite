AI_DEPLOYMENT_MODE=LOCAL_ONLY
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8015
AI_SERVICE_API_KEY=dev-ai-service-key

# Local OpenAI-compatible model services. API keys are optional in LOCAL_ONLY mode.
QWEN_BASE_URL=http://local-llm:8000/v1
QWEN_API_KEY=
QWEN_MODEL=smart-worksite-chat
QWEN_TIMEOUT_SECONDS=120
QWEN_VL_ENDPOINT=http://local-llm:8000/v1/chat/completions
QWEN_VL_API_KEY=
QWEN_VL_MODEL=smart-worksite-chat
QWEN_VL_TIMEOUT_SECONDS=120
QWEN_VL_MAX_IMAGE_BYTES=10485760
QWEN_VL_MAX_TOKENS=8192
QWEN_EMBEDDING_BASE_URL=http://local-embedding:8000/v1
QWEN_EMBEDDING_MODEL=smart-worksite-embedding
QWEN_EMBEDDING_DIMENSIONS=0
QWEN_EMBEDDING_BATCH_SIZE=10
QWEN_RERANK_BASE_URL=http://local-reranker:8000/v1/rerank
QWEN_RERANK_MODEL=smart-worksite-reranker
QWEN_RERANK_API_STYLE=QWEN3

RAG_PROVIDER=LOCAL
RERANK_PROVIDER=QWEN
RAG_DATA_DIR=data/rag
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_RERANK_TOP_K=20
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=smart_worksite_chunks
PGVECTOR_DSN=
PGVECTOR_TABLE=smart_worksite_chunks
EMBEDDING_PROVIDER=QWEN